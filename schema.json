{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://funkfinger.github.io/binkey-data/schema.json",
  "title": "Binkey-Data Part",
  "description": "Canonical frontmatter schema for parts inventory markdown files",
  "type": "object",
  "required": [
    "type", "category", "part_number", "manufacturer", "description",
    "location", "quantity", "status", "tags"
  ],
  "properties": {
    "title": {
      "type": "string",
      "description": "Display name shown as page title (Quartz uses this)"
    },
    "type": {
      "type": "string",
      "enum": ["ic", "dev-board", "mechanical", "passive", "module", "kit", "other"],
      "description": "Canonical part type"
    },
    "category": {
      "type": "string",
      "description": "Broad category, e.g. 'Integrated Circuits'"
    },
    "subcategory": {
      "type": "string",
      "description": "Narrower grouping within category"
    },
    "part_number": {
      "type": "string",
      "description": "Manufacturer or vendor part number"
    },
    "manufacturer": {
      "type": "string",
      "description": "Official manufacturer name — canonical, replaces brand"
    },
    "description": {
      "type": "string",
      "description": "Short one-line description of the part"
    },
    "location": {
      "oneOf": [
        {
          "type": "string",
          "description": "Slash-delimited location e.g. Cabinet-3/Bin-7/Section-A"
        },
        {
          "type": "array",
          "items": { "type": "string" },
          "description": "Multiple locations for parts spread across bins"
        }
      ]
    },
    "quantity": {
      "oneOf": [
        { "type": "integer", "minimum": 0 },
        { "type": "string", "description": "e.g. '200+' for approximate quantities" }
      ]
    },
    "status": {
      "type": "string",
      "enum": ["available", "low-stock", "out-of-stock", "todo"],
      "description": "Current stock status"
    },
    "price": {
      "type": "string",
      "description": "Price or price range e.g. '$3.95' or '$0.15-0.30' — canonical, replaces price_range/cost_per_unit/list_price"
    },
    "product_url": {
      "type": "string",
      "description": "Purchase or product page URL — canonical, replaces purchase_url/supplier_url/digikey_url"
    },
    "datasheet": {
      "type": "string",
      "description": "Datasheet URL or 'N/A' — canonical, replaces datasheet_url"
    },
    "date_added": {
      "type": "string",
      "description": "ISO 8601 date added to inventory e.g. 2026-05-14 — canonical, replaces added_date"
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Lowercase hyphen-separated searchable tags"
    }
  },
  "additionalProperties": true,
  "_deprecated": {
    "brand": "Use manufacturer",
    "price_range": "Use price",
    "purchase_url": "Use product_url",
    "supplier_url": "Use product_url",
    "digikey_url": "Use product_url",
    "datasheet_url": "Use datasheet",
    "added_date": "Use date_added"
  }
}
